# Bu shablon fayli. Haqiqiy kalitlarni bu yerga EMAS,
# Cloudflare Dashboard > Workers & Pages > a24 > Settings > Variables and Secrets bo'limiga kiriting!

# Google AI Studio API kaliti (Secret)
GEMINI_API_KEY=your_gemini_api_key_here

# Saytga kirish uchun maxfiy parol (Secret)
APP_PASSWORD=your_strong_password_here

# Institut ma'lumotlari va statistikasini tahrirlash uchun maxfiy admin paroli (Secret)
ADMIN_PASS=your_admin_secret_password_here
# yoki kichik harflar bilan: admin_pass=your_admin_secret_password_here

# Sessiya imzolash uchun maxfiy kalit (Secret)
SESSION_SECRET=random_long_secret_string_here

# Cloudflare AI Gateway sozlamalari (Optional)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
AI_GATEWAY_NAME=adchti-gemini-gateway

# Modellarni belgilash
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE=Aoede
